<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="640" height="480" viewBox="0 0 640 480">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0b1730"/>
      <stop offset="1" stop-color="#030712"/>
    </linearGradient>
    <linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#4f9bff"/>
      <stop offset="1" stop-color="#1a4dff"/>
    </linearGradient>
  </defs>
  <rect width="640" height="480" fill="url(#bg)"/>
  <!-- the Nexwall mark -->
  <g transform="translate(256,34) scale(2)">
    <rect width="64" height="64" rx="14" fill="#0b1730" stroke="#2b4a8f" stroke-width="1"/>
    <path d="M18 46V18h8l12 17.5V18h8v28h-8L26 28.5V46z" fill="url(#g)"/>
  </g>
  <text x="320" y="216" text-anchor="middle" font-family="DejaVu Sans, Liberation Sans, sans-serif" font-size="32" font-weight="bold" fill="#ffffff">Nexwall Firewall Installer</text>
  <text x="320" y="248" text-anchor="middle" font-family="DejaVu Sans, Liberation Sans, sans-serif" font-size="20" fill="#7aa2ff">Version @NEXWALL_VERSION@</text>
  <text x="320" y="440" text-anchor="middle" font-family="DejaVu Sans, Liberation Sans, sans-serif" font-size="12" fill="#6b7a99">nexwall.com.br</text>
